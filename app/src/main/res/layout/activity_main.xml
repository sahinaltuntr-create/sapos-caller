<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F4"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="SaPOS Caller &amp; WhatsApp Köprüsü"
            android:textColor="#881337"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#FEF3C7"
            android:padding="10dp"
            android:text="Durum kontrol ediliyor..."
            android:textColor="#78350F"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Kasa PC Yerel Ağ IP Adresi (Örn: 192.168.1.50)"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etHost"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="192.168.1.50"
            android:inputType="textUri" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Port (Varsayılan: 3000)"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etPort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="3000"
            android:inputType="number" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swCaller"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:checked="true"
            android:text="Gelen Aramaları (Caller ID) Kasaya Gönder" />

        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swWa"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:checked="true"
            android:text="WhatsApp / Business Bildirimlerini Kasaya Gönder" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnSave"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="#15803D"
                android:text="Kaydet &amp; Başlat" />

            <Button
                android:id="@+id/btnTestConn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="#1E40AF"
                android:text="Kasayı Test Et" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Gerekli Android İzinleri (İlk Kurulumda 1 Kez)"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnPermPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:backgroundTint="#B45309"
            android:text="1. Telefon ve Arama Kaydı İzni Ver" />

        <Button
            android:id="@+id/btnPermNotif"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:backgroundTint="#B45309"
            android:text="2. WhatsApp Bildirim Erişimi Aç" />

        <Button
            android:id="@+id/btnBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:backgroundTint="#475569"
            android:text="3. Pil Kısıtlamasını Kaldır (Arka Plan)" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnTestCall"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:backgroundTint="#881337"
                android:text="Test Araması At" />

            <Button
                android:id="@+id/btnTestWa"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:backgroundTint="#047857"
                android:text="Test WA Siparişi" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Canlı Gönderim Günlüğü"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#0F172A"
            android:fontFamily="monospace"
            android:minHeight="140dp"
            android:padding="10dp"
            android:text="Henüz işlem kaydı yok."
            android:textColor="#E2E8F0"
            android:textSize="11sp" />

    </LinearLayout>
</ScrollView>
